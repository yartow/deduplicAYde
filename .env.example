# Absolute path to the external hard drive mount point
DATA_DIR=/Volumes/External/photos_cleanup

# Optional: override detection thresholds
BLUR_THRESHOLD=100
EDGE_THRESHOLD=0.05
OCR_DENSITY_THRESHOLD=0.001
PHASH_HAMMING_THRESHOLD=10

# Timezone your Google Photos account displays times in (round0 converts
# Takeout sidecar timestamps, which are UTC, to this zone so they match what
# locate_stage.py sees in the UI when staging items)
ACCOUNT_TIMEZONE=Europe/Amsterdam

# AI quality scoring (quality-score command; see README "AI quality scoring")
# true (default) = runs in the `quality` Docker service, CPU-only, works
# everywhere. false = runs natively on the host via .venv-quality/, using
# PyTorch's `mps` backend on Apple Silicon — the one deliberate exception to
# this project's "never installed on host" rule (see CLAUDE.md). Run
# ./scripts/setup_quality_native_env.sh once before setting this to false.
QUALITY_SCORING_DOCKER=true

# Which pretrained no-reference image-quality model tier: 'medium' (musiq) or
# 'heavyweight' (clipiqa+_vitL14_512, slower, full CLIP ViT-L/14 backbone).
# Overridable per-run with `quality-score --tier`.
QUALITY_TIER=medium
